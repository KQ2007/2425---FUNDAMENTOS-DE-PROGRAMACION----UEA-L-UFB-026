def calcular_temperatura_promedio(datos_temperaturas):
    """
    Calcula la temperatura promedio de cada ciudad durante un período de tiempo.

    Args:
        datos_temperaturas (dict): Un diccionario donde las claves son los nombres de las ciudades
                                  y los valores son listas de listas, representando las temperaturas
                                  semanales de cada ciudad.

    Returns:
        dict: Un diccionario donde las claves son los nombres de las ciudades y los valores son las
              temperaturas promedio correspondientes.
    """

    temperaturas_promedio = {}  # Diccionario para almacenar las temperaturas promedio de cada ciudad

    for ciudad, temperaturas_semanales in datos_temperaturas.items():
        # Itera sobre cada ciudad y sus datos de temperatura semanales
        total_temperaturas = 0
        total_semanas = 0

        for temperaturas_semana in temperaturas_semanales:
            # Itera sobre cada semana de temperaturas
            total_temperaturas += sum(temperaturas_semana)  # Suma todas las temperaturas de la semana
            total_semanas += len(temperaturas_semana)  # Cuenta el número total de temperaturas

        promedio = total_temperaturas / total_semanas if total_semanas > 0 else 0
        # Calcula el promedio de temperaturas para la ciudad
        temperaturas_promedio[ciudad] = promedio  # Almacena el promedio en el diccionario

    return temperaturas_promedio
# Ejemplo de datos de temperaturas (3 ciudades, 4 semanas)
datos_temperaturas = {
    "Ciudad A": [[25, 28, 30, 27], [24, 26, 29, 28], [26, 29, 31, 30], [27, 30, 32, 31]],
    "Ciudad B": [[20, 22, 24, 23], [21, 23, 25, 24], [22, 24, 26, 25], [23, 25, 27, 26]],
    "Ciudad C": [[30, 32, 34, 33], [31, 33, 35, 34], [32, 34, 36, 35], [33, 35, 37, 36]],
}

# Calcula las temperaturas promedio
promedios = calcular_temperatura_promedio(datos_temperaturas)

# Imprime los resultados
for ciudad, promedio in promedios.items():
    print(f"Temperatura promedio en {ciudad}: {promedio:.2f} grados")
